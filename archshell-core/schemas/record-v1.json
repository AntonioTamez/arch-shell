{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archshell/record/v1",
  "title": "ArchShell confirmation record",
  "description": "One human confirmation: .archshell/records/<feature-slug>/<seq>-<flow>.yaml (FR-53, AD-10). Append-only.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "archshell/record/v1"
    },
    "feature": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "flow": {
      "enum": ["plan", "extension", "contract", "contract-revision", "breaking-change", "growth", "vocabulary"]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "confirmed_by": {
      "description": "Self-reported identity of the confirming human (AD-18).",
      "type": "string",
      "minLength": 1,
      "pattern": "[^ \\t\\n\\r]"
    },
    "confirmed_at": {
      "description": "UTC, YYYY-MM-DDTHH:MM:SSZ.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "derived": {
      "description": "True when the confirmed content is derived, with no new decisions (FR-59).",
      "type": "boolean"
    },
    "content": {
      "description": "The confirmed content, optional."
    }
  },
  "required": ["schema", "feature", "seq", "flow", "fingerprint", "confirmed_by", "confirmed_at", "derived"],
  "additionalProperties": false
}
