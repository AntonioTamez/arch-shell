{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archshell/architecture/v1",
  "title": "ArchShell architecture",
  "description": "The project's rendered architecture.yaml, derived from .archshell/charter/base.yaml plus the version pins. Every field but `language` is language-neutral.",
  "type": "object",
  "properties": {
    "language": {"type": "string", "minLength": 1},
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"}
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["clean", "screaming"]}
    },
    "versions": {
      "type": "object",
      "properties": {
        "core": {"type": "string", "minLength": 1},
        "packs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      },
      "required": ["core", "packs"],
      "additionalProperties": false
    }
  },
  "required": ["language", "modules", "patterns", "versions"],
  "additionalProperties": false
}
