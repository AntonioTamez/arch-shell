{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archshell/charter/v1",
  "title": "ArchShell base charter",
  "description": "The project's .archshell/charter/base.yaml: the request, its drivers, the confirmed modules with their capabilities, and the confirmed patterns.",
  "type": "object",
  "properties": {
    "schema": {"const": "archshell/charter/v1"},
    "decision": {"enum": ["automatic"]},
    "drivers": {
      "type": "object",
      "properties": {
        "audit_needs": {"enum": ["none", "basic", "strict", "unknown"]},
        "deployment_model": {"enum": ["monolith", "services", "serverless", "unknown"]},
        "domain_complexity": {"enum": ["low", "medium", "high", "unknown"]},
        "integrations": {"enum": ["none", "few", "many", "unknown"]},
        "read_write_asymmetry": {"enum": ["balanced", "read_heavy", "write_heavy", "unknown"]},
        "scale": {"enum": ["small", "medium", "large", "unknown"]},
        "team_size": {"enum": ["solo", "small", "large", "unknown"]}
      },
      "required": [
        "audit_needs", "deployment_model", "domain_complexity", "integrations",
        "read_write_asymmetry", "scale", "team_size"
      ],
      "additionalProperties": false
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
          "capabilities": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        },
        "required": ["name", "capabilities"],
        "additionalProperties": false
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["clean", "screaming"]}
    },
    "request": {"type": "string", "minLength": 1}
  },
  "required": ["schema", "decision", "drivers", "modules", "patterns", "request"],
  "additionalProperties": false
}
