{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archshell/drivers/v1",
  "title": "Architecture drivers",
  "description": "The drivers an llm_task extracts from the developer's request (its text result, parsed as JSON). A driver the request does not establish is `unknown`, or left out.",
  "type": "object",
  "properties": {
    "audit_needs": {"enum": ["none", "basic", "strict", "unknown"]},
    "deployment_model": {"enum": ["monolith", "services", "serverless", "unknown"]},
    "domain_complexity": {"enum": ["low", "medium", "high", "unknown"]},
    "integrations": {"enum": ["none", "few", "many", "unknown"]},
    "read_write_asymmetry": {"enum": ["balanced", "read_heavy", "write_heavy", "unknown"]},
    "scale": {"enum": ["small", "medium", "large", "unknown"]},
    "team_size": {"enum": ["solo", "small", "large", "unknown"]},
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/module"}
    }
  },
  "required": ["modules"],
  "additionalProperties": false,
  "$defs": {
    "module": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
        "capabilities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": ["name", "capabilities"],
      "additionalProperties": false
    }
  }
}
